{
  "name": "opendb-store",
  "version": "3.0.0-next.1",
  "description": "Typed localStorage, sessionStorage, cookie, and IndexedDB wrapper with expiry (TTL), namespaces, cross-tab sync, compression, and SSR safety. Zero dependencies, about 4.5 kB.",
  "main": "./dist/opendb.cjs",
  "module": "./dist/opendb-esm.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/opendb-esm.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/opendb.cjs"
      }
    },
    "./query": {
      "import": {
        "types": "./dist/query.d.ts",
        "default": "./dist/query.js"
      },
      "require": {
        "types": "./dist/query.d.cts",
        "default": "./dist/query.cjs"
      }
    },
    "./debug": {
      "import": {
        "types": "./dist/debug.d.ts",
        "default": "./dist/debug.js"
      },
      "require": {
        "types": "./dist/debug.d.cts",
        "default": "./dist/debug.cjs"
      }
    },
    "./indexeddb": {
      "import": {
        "types": "./dist/indexeddb.d.ts",
        "default": "./dist/indexeddb.js"
      },
      "require": {
        "types": "./dist/indexeddb.d.cts",
        "default": "./dist/indexeddb.cjs"
      }
    },
    "./compress": {
      "import": {
        "types": "./dist/compress.d.ts",
        "default": "./dist/compress.js"
      },
      "require": {
        "types": "./dist/compress.d.cts",
        "default": "./dist/compress.cjs"
      }
    },
    "./cache": {
      "import": {
        "types": "./dist/cache.d.ts",
        "default": "./dist/cache.js"
      },
      "require": {
        "types": "./dist/cache.d.cts",
        "default": "./dist/cache.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/*.js",
    "dist/*.cjs",
    "dist/*.map",
    "dist/*.d.ts",
    "dist/*.d.cts"
  ],
  "scripts": {
    "prepare": "husky",
    "typecheck": "tsc",
    "lint": "eslint src tests scripts bench",
    "lint:fix": "eslint src tests scripts bench --fix",
    "format": "prettier --write .",
    "clean": "rm -rf dist",
    "module-package-json": "echo \"export const version = '${npm_package_version}';\" > src/version.ts",
    "version": "npm run module-package-json",
    "bundle": "npm run module-package-json && npm run clean && rollup -c",
    "minify-esm": "terser dist/opendb-esm.js -o dist/opendb-esm.min.js --compress passes=2 --mangle --module --ecma 2020",
    "minify-umd": "terser dist/opendb-umd.js -o dist/opendb-umd.min.js --compress passes=2 --mangle --ecma 2020",
    "build": "npm run bundle && npm run minify-esm && npm run minify-umd && npm run minify-debug && npm run minify-indexeddb && npm run minify-compress",
    "test": "npm run lint && npm run typecheck && npm run test:coverage",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:coverage": "vitest run --project unit --coverage",
    "check:package": "npm run build && publint --strict && attw --pack . --profile node16 && size-limit && npm run api:check && node scripts/smoke.mjs",
    "semantic-release": "semantic-release",
    "prepublishOnly": "npm run check:package",
    "minify-debug": "terser dist/debug-umd.js -o dist/debug-umd.min.js --compress passes=2 --mangle --ecma 2020",
    "demo": "npm run build && node scripts/serve.mjs",
    "minify-indexeddb": "terser dist/indexeddb-umd.js -o dist/indexeddb-umd.min.js --compress passes=2 --mangle --ecma 2020",
    "minify-compress": "terser dist/compress-umd.js -o dist/compress-umd.min.js --compress passes=2 --mangle --ecma 2020",
    "api:check": "node scripts/api-report.mjs",
    "api:update": "node scripts/api-report.mjs --update",
    "test:coverage:all": "npm run build && BROWSERS=chromium vitest run --coverage",
    "test:examples": "node scripts/examples-check.mjs",
    "test:csp": "node scripts/csp-check.mjs",
    "test:mutation": "stryker run",
    "bench": "npm run build && node bench/run.mjs",
    "docs:api": "typedoc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pankajbisht/opendb-store.git"
  },
  "keywords": [
    "localstorage",
    "sessionstorage",
    "cookie",
    "cookies",
    "indexeddb",
    "storage",
    "browser-storage",
    "web-storage",
    "local-storage",
    "session-storage",
    "ttl",
    "expire",
    "expiry",
    "cache",
    "lru",
    "compression",
    "namespace",
    "cross-tab",
    "persist",
    "offline",
    "key-value",
    "typescript",
    "react",
    "react-hook",
    "angular",
    "nextjs",
    "ssr",
    "zero-dependency"
  ],
  "author": "Pankaj Bisht",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/pankajbisht/opendb-store/issues"
  },
  "homepage": "https://github.com/pankajbisht/opendb-store#readme",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-typescript": "^12.3.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.5",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@size-limit/file": "^14.3.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "fake-indexeddb": "^6.2.8",
    "fast-check": "^4.10.2",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "lint-staged": "^16.2.7",
    "playwright": "^1.65.0",
    "prettier": "^3.8.1",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rollup": "^4.57.1",
    "rollup-plugin-dts": "^6.5.1",
    "semantic-release": "^25.0.3",
    "size-limit": "^14.3.0",
    "terser": "^5.46.0",
    "tslib": "^2.9.1",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "{src,tests}/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "directories": {
    "test": "tests"
  },
  "sideEffects": false,
  "unpkg": "./dist/opendb-umd.min.js",
  "jsdelivr": "./dist/opendb-umd.min.js",
  "engines": {
    "node": ">=20"
  },
  "size-limit": [
    {
      "name": "core",
      "path": "dist/opendb-esm.min.js",
      "limit": "4.6 kB",
      "gzip": true
    },
    {
      "name": "indexeddb",
      "path": "dist/indexeddb-umd.min.js",
      "limit": "5.2 kB",
      "gzip": true
    },
    {
      "name": "compress",
      "path": "dist/compress-umd.min.js",
      "limit": "1.5 kB",
      "gzip": true
    },
    {
      "name": "cache",
      "path": "dist/cache.js",
      "limit": "1.2 kB",
      "gzip": true
    },
    {
      "name": "react",
      "path": "dist/react.js",
      "limit": "0.6 kB",
      "gzip": true
    }
  ],
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
