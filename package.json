{
  "name": "opendb-store",
  "version": "2.0.1",
  "description": "A lightweight, zero-dependency wrapper for localStorage, sessionStorage, and cookies with namespaces, expiry, cross-tab events, and TypeScript types.",
  "main": "./dist/opendb.cjs",
  "module": "./dist/opendb-esm.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/opendb-esm.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/opendb.cjs"
      }
    },
    "./query": {
      "import": {
        "types": "./dist/query.d.ts",
        "default": "./dist/query.js"
      },
      "require": {
        "types": "./dist/query.d.cts",
        "default": "./dist/query.cjs"
      }
    },
    "./debug": {
      "import": {
        "types": "./dist/debug.d.ts",
        "default": "./dist/debug.js"
      },
      "require": {
        "types": "./dist/debug.d.cts",
        "default": "./dist/debug.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/*.js",
    "dist/*.cjs",
    "dist/*.map",
    "dist/*.d.ts",
    "dist/*.d.cts"
  ],
  "scripts": {
    "prepare": "husky",
    "typecheck": "tsc",
    "lint": "eslint src tests scripts",
    "lint:fix": "eslint src tests scripts --fix",
    "format": "prettier --write .",
    "clean": "rm -rf dist",
    "module-package-json": "echo \"export const version = '${npm_package_version}';\" > src/version.ts",
    "bundle": "npm run module-package-json && npm run clean && rollup -c",
    "minify-esm": "terser dist/opendb-esm.js -o dist/opendb-esm.min.js --compress passes=2 --mangle --module --ecma 2020",
    "minify-umd": "terser dist/opendb-umd.js -o dist/opendb-umd.min.js --compress passes=2 --mangle --ecma 2020",
    "build": "npm run bundle && npm run minify-esm && npm run minify-umd && npm run minify-debug",
    "test": "npm run lint && npm run typecheck && npm run test:coverage",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:coverage": "vitest run --project unit --coverage",
    "check:package": "npm run build && publint --strict && attw --pack . --profile node16 && size-limit && node scripts/smoke.mjs",
    "semantic-release": "semantic-release",
    "prepublishOnly": "npm run check:package",
    "minify-debug": "terser dist/debug-umd.js -o dist/debug-umd.min.js --compress passes=2 --mangle --ecma 2020"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pankajbisht/opendb-store.git"
  },
  "keywords": [
    "opendb-store",
    "opendb",
    "store",
    "localStorage",
    "sessionStorage",
    "state-management",
    "data-storage",
    "browser-storage",
    "key-value-store",
    "lightweight-storage",
    "js-storage",
    "persistent-storage",
    "storage-utility",
    "web-storage",
    "cache",
    "frontend-storage",
    "react-storage",
    "vanilla-js-storage",
    "typescript-storage",
    "localstore",
    "sessionstore",
    "cookies",
    "cookie",
    "cross-tab",
    "ttl",
    "ssr"
  ],
  "author": "Pankaj Bisht",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/pankajbisht/opendb-store/issues"
  },
  "homepage": "https://github.com/pankajbisht/opendb-store#readme",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-typescript": "^12.3.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.5",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@size-limit/file": "^14.3.0",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "lint-staged": "^16.2.7",
    "playwright": "^1.65.0",
    "prettier": "^3.8.1",
    "publint": "^0.3.25",
    "rollup": "^4.57.1",
    "rollup-plugin-dts": "^6.5.1",
    "semantic-release": "^25.0.3",
    "size-limit": "^14.3.0",
    "terser": "^5.46.0",
    "tslib": "^2.9.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "{src,tests}/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "directories": {
    "test": "tests"
  },
  "sideEffects": false,
  "unpkg": "./dist/opendb-umd.min.js",
  "jsdelivr": "./dist/opendb-umd.min.js",
  "engines": {
    "node": ">=20"
  },
  "size-limit": [
    {
      "name": "core",
      "path": "dist/opendb-esm.min.js",
      "limit": "3.5 kB",
      "gzip": true
    }
  ]
}
